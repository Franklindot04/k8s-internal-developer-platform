{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idp-service-v1alpha1",
  "title": "PlatformService v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "idp/v1alpha1"
    },
    "kind": {
      "const": "PlatformService"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "owner": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "runtime", "resources", "availability"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\s]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "healthPath"],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "healthPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/[^\\s?#]*$"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": {
            "profile": {
              "enum": ["small", "medium", "large"]
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": {
            "profile": {
              "enum": ["single", "standard"]
            }
          }
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envFrom"],
          "properties": {
            "envFrom": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    }
  }
}
